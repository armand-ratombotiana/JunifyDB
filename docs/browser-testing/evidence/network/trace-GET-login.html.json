{"method":"GET","url":"http://localhost:9090/jnosql-admin/login.html","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Date":["Wed, 16 Sep 2026 13:48:30 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-credentials":["true"],"Content-length":["10374"],"X-content-type-options":["nosniff"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>JunifyDB — Sign In</title>\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n    <link rel=\"stylesheet\" href=\"/css/enhancements.css\">\n    <style>\n        :root {\n            --bg-base: #090914;\n            --bg-card: rgba(18, 20, 38, 0.85);\n            --border-card: rgba(255, 255, 255, 0.08);\n            --accent-grad: linear-gradient(135deg, #6366f1, #a855f7);\n            --accent-glow: rgba(99, 102, 241, 0.25);\n            --text-main: #f8fafc;\n            --text-sub: #94a3b8;\n        }\n        body {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            min-height: 100vh;\n            background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.12) 0%, transparent 60%), #090914;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n            color: var(--text-main);\n            margin: 0;\n            padding: 24px;\n            box-sizing: border-box;\n        }\n        .login-card {\n            background: var(--bg-card);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border: 1px solid var(--border-card);\n            border-radius: 16px;\n            width: 100%;\n            max-width: 420px;\n            padding: 36px 32px;\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\n        }\n        .login-header {\n            text-align: center;\n            margin-bottom: 28px;\n        }\n        .login-logo-wrap {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 14px;\n            border-radius: 18px;\n            box-shadow: 0 8px 24px var(--accent-glow);\n        }\n        .login-title {\n            font-size: 1.6rem;\n            font-weight: 700;\n            letter-spacing: -0.02em;\n            color: #ffffff;\n            margin: 0 0 6px 0;\n        }\n        .login-subtitle {\n            font-size: 0.85rem;\n            color: var(--text-sub);\n            margin: 0;\n        }\n        .login-badge {\n            display: inline-block;\n            margin-top: 8px;\n            padding: 3px 10px;\n            border-radius: 50px;\n            font-size: 0.72rem;\n            font-weight: 600;\n            background: rgba(99, 102, 241, 0.15);\n            color: #a5b4fc;\n            border: 1px solid rgba(99, 102, 241, 0.3);\n        }\n        .form-group {\n            margin-bottom: 18px;\n        }\n        .form-label {\n            display: block;\n            font-size: 0.82rem;\n            font-weight: 600;\n            color: #cbd5e1;\n            margin-bottom: 6px;\n        }\n        .form-input {\n            width: 100%;\n            padding: 11px 14px;\n            background-color: rgba(10, 12, 24, 0.75);\n            border: 1px solid rgba(255, 255, 255, 0.12);\n            border-radius: 8px;\n            color: #ffffff;\n            font-size: 0.88rem;\n            box-sizing: border-box;\n            transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;\n        }\n        .form-input:focus {\n            outline: none;\n            background-color: rgba(15, 18, 35, 0.95);\n            border-color: #6366f1;\n            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);\n        }\n        .form-input::placeholder {\n            color: #64748b;\n        }\n        .btn-submit {\n            width: 100%;\n            padding: 12px 18px;\n            background: var(--accent-grad);\n            color: #ffffff;\n            border: none;\n            border-radius: 8px;\n            font-size: 0.9rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;\n            margin-top: 10px;\n            box-shadow: 0 4px 16px var(--accent-glow);\n        }\n        .btn-submit:hover:not(:disabled) {\n            opacity: 0.94;\n            transform: translateY(-1px);\n            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);\n        }\n        .btn-submit:disabled {\n            opacity: 0.6;\n            cursor: not-allowed;\n        }\n        .error-message {\n            display: none;\n            background-color: rgba(239, 68, 68, 0.15);\n            border: 1px solid rgba(239, 68, 68, 0.4);\n            color: #fca5a5;\n            padding: 11px 14px;\n            border-radius: 8px;\n            font-size: 0.84rem;\n            margin-bottom: 18px;\n            line-height: 1.4;\n        }\n        .login-footer {\n            margin-top: 28px;\n            text-align: center;\n            font-size: 0.75rem;\n            color: #64748b;\n            border-top: 1px solid rgba(255, 255, 255, 0.06);\n            padding-top: 16px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"login-card\">\n        <div class=\"login-header\">\n            <div class=\"login-logo-wrap\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 400\" width=\"54\" height=\"54\">\n                    <defs>\n                        <linearGradient id=\"lgLogin\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#6366f1\"/><stop offset=\"1\" stop-color=\"#a855f7\"/></linearGradient>\n                    </defs>\n                    <rect x=\"50\" y=\"50\" width=\"300\" height=\"300\" rx=\"60\" fill=\"url(#lgLogin)\"/>\n                    <g transform=\"translate(100,100)\">\n                        <ellipse cx=\"100\" cy=\"30\" rx=\"70\" ry=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.9\"/>\n                        <path d=\"M30 30 L30 170 Q30 190 100 190 Q170 190 170 170 L170 30\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.8\"/>\n                        <ellipse cx=\"100\" cy=\"100\" rx=\"70\" ry=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.6\"/>\n                        <ellipse cx=\"100\" cy=\"170\" rx=\"70\" ry=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.4\"/>\n                    </g>\n                </svg>\n            </div>\n            <h1 class=\"login-title\">JunifyDB Console</h1>\n            <p class=\"login-subtitle\">Sign in to manage your embedded database</p>\n            <span class=\"login-badge\">Dual-Engine &bull; NoSQL + ANSI SQL</span>\n        </div>\n\n        <div id=\"errorMessage\" class=\"error-message\" role=\"alert\"></div>\n\n        <form id=\"loginForm\" onsubmit=\"handleLogin(event)\">\n            <div class=\"form-group\">\n                <label class=\"form-label\" for=\"username\">Username</label>\n                <input class=\"form-input\" type=\"text\" id=\"username\" name=\"username\" value=\"admin\" autocomplete=\"username\" placeholder=\"e.g. admin\">\n            </div>\n\n            <div class=\"form-group\">\n                <label class=\"form-label\" for=\"password\">Password</label>\n                <input class=\"form-input\" type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" placeholder=\"••••••••\">\n            </div>\n\n            <div class=\"form-group\">\n                <label class=\"form-label\" for=\"apiKey\">API Key (Optional)</label>\n                <input class=\"form-input\" type=\"password\" id=\"apiKey\" name=\"apiKey\" placeholder=\"Leave blank if disabled\">\n            </div>\n\n            <button type=\"submit\" class=\"btn-submit\" id=\"submitBtn\">Sign In</button>\n        </form>\n\n        <div class=\"login-footer\">\n            JunifyDB Embedded Multi-Model Database &bull; Secure Console\n        </div>\n    </div>\n\n    <script>\n        const getBasePath = () => {\n            let p = window.location.pathname;\n            if (p.endsWith('.html')) p = p.substring(0, p.lastIndexOf('/'));\n            while (p.endsWith('/')) p = p.slice(0, -1);\n            return p;\n        };\n        const BASE_PATH = getBasePath();\n        const API_LOGIN = BASE_PATH ? (BASE_PATH + '/api/auth/login') : '/api/auth/login';\n\n        async function handleLogin(e) {\n            e.preventDefault();\n            const submitBtn = document.getElementById('submitBtn');\n            const errorEl = document.getElementById('errorMessage');\n            const username = document.getElementById('username').value.trim();\n            const password = document.getElementById('password').value;\n            const apiKey = document.getElementById('apiKey').value.trim();\n\n            errorEl.style.display = 'none';\n            submitBtn.disabled = true;\n            submitBtn.textContent = 'Signing in...';\n\n            try {\n                const res = await fetch(API_LOGIN, {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({ username, password, apiKey })\n                });\n\n                if (res.ok) {\n                    const data = await res.json().catch(() => ({}));\n                    const headerCsrf = res.headers.get('X-CSRF-Token');\n                    const csrf = data.csrfToken || headerCsrf;\n                    if (csrf) {\n                        sessionStorage.setItem('csrfToken', csrf);\n                    }\n                    if (data.session) {\n                        sessionStorage.setItem('session', data.session);\n                    }\n                    if (apiKey) {\n                        localStorage.setItem('apiKey', apiKey);\n                    }\n                    window.location.href = BASE_PATH ? (BASE_PATH + '/index.html') : 'index.html';\n                } else {\n                    const err = await res.json().catch(() => ({ message: 'Sign in failed' }));\n                    errorEl.textContent = err.message || 'Invalid credentials or API key';\n                    errorEl.style.display = 'block';\n                }\n            } catch (err) {\n                // If auth is not enabled on server, direct redirect\n                if (apiKey) localStorage.setItem('apiKey', apiKey);\n                window.location.href = BASE_PATH ? (BASE_PATH + '/index.html') : 'index.html';\n            } finally {\n                submitBtn.disabled = false;\n                submitBtn.textContent = 'Sign In';\n            }\n        }\n    </script>\n</body>\n</html>\n"}